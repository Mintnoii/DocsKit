{
  "name": "cyberbrain",
  "version": "0.1.0",
  "description": "Cyberbrain (電脳) — Bebop 全机编译型知识库核心通用引擎 (Compile-over-Retrieval Core)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ast": {
      "types": "./dist/ast/index.d.ts",
      "import": "./dist/ast/index.js"
    },
    "./sense": {
      "types": "./dist/sense/index.d.ts",
      "import": "./dist/sense/index.js"
    },
    "./patch": {
      "types": "./dist/patch/index.d.ts",
      "import": "./dist/patch/index.js"
    },
    "./lint": {
      "types": "./dist/lint/index.d.ts",
      "import": "./dist/lint/index.js"
    },
    "./hash": {
      "types": "./dist/hash/index.d.ts",
      "import": "./dist/hash/index.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot/index.d.ts",
      "import": "./dist/snapshot/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "import": "./dist/pipeline/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sinclair/typebox": "^0.34.14",
    "@xenova/transformers": "^2.17.2",
    "gray-matter": "^4.0.3",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.3",
    "micromark-extension-gfm": "^3.0.0",
    "pathe": "^2.0.3",
    "radash": "^12.1.1",
    "semver": "^7.8.6",
    "unist-util-select": "^5.1.0",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "compute-cosine-similarity": "^1.1.0",
    "tsup": "^8.3.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
