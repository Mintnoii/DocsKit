{
  "name": "docskit",
  "version": "0.1.0",
  "description": "Pure TypeScript functions for cleaning, compiling, and searching Markdown knowledge bases",
  "license": "MIT",
  "author": "Mintnoii",
  "homepage": "https://github.com/Mintnoii/DocsKit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mintnoii/DocsKit.git"
  },
  "bugs": {
    "url": "https://github.com/Mintnoii/DocsKit/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "keywords": [
    "knowledge-base",
    "markdown",
    "mdast",
    "rag",
    "bm25",
    "llm-wiki",
    "typescript"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ast": {
      "types": "./dist/ast/index.d.ts",
      "import": "./dist/ast/index.js"
    },
    "./okf": {
      "types": "./dist/okf/index.d.ts",
      "import": "./dist/okf/index.js"
    },
    "./sense": {
      "types": "./dist/sense/index.d.ts",
      "import": "./dist/sense/index.js"
    },
    "./patch": {
      "types": "./dist/patch/index.d.ts",
      "import": "./dist/patch/index.js"
    },
    "./lint": {
      "types": "./dist/lint/index.d.ts",
      "import": "./dist/lint/index.js"
    },
    "./hash": {
      "types": "./dist/hash/index.d.ts",
      "import": "./dist/hash/index.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot/index.d.ts",
      "import": "./dist/snapshot/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "import": "./dist/graph/index.js"
    },
    "./jit": {
      "types": "./dist/jit/index.d.ts",
      "import": "./dist/jit/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "import": "./dist/pipeline/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.14",
    "@xenova/transformers": "^2.17.2",
    "fdir": "^6.5.0",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.3",
    "micromark-extension-gfm": "^3.0.0",
    "outdent": "^0.8.0",
    "pathe": "^2.0.3",
    "picomatch": "^4.0.7",
    "radash": "^12.1.1",
    "semver": "^7.8.6",
    "unist-util-select": "^5.1.0",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/semver": "^7.8.0",
    "tsup": "^8.3.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
